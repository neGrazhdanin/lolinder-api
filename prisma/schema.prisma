generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RankedQueue {
  SOLO @map("solo")
  FLEX @map("flex")

  @@map("ranked_queue")
}

enum Tier {
  IRON        @map("iron")
  BRONZE      @map("bronze")
  SILVER      @map("silver")
  GOLD        @map("gold")
  PLATINUM    @map("platinum")
  EMERALD     @map("emerald")
  DIAMOND     @map("diamond")
  MASTER      @map("master")
  GRANDMASTER @map("grandmaster")
  CHALLENGER  @map("challenger")

  @@map("tier")
}

enum Division {
  I
  II
  III
  IV

  @@map("division")
}

enum StaticDataKind {
  CHAMPIONS       @map("champions")
  ITEMS           @map("items")
  RUNES           @map("runes")
  SUMMONER_SPELLS @map("summoner_spells")

  @@map("static_data_kind")
}

/// PUUID is encrypted per API key: gameName and tagLine are kept to re-resolve it after a key change.
model RiotAccount {
  puuid                String    @id @db.VarChar(78)
  gameName             String    @map("game_name")
  tagLine              String    @map("tag_line")
  /// Lowercased `gameName#tagLine`: Riot IDs are case-insensitive, and ILIKE cannot use a B-tree index.
  riotIdKey            String    @map("riot_id_key")
  platform             String
  profileIconId        Int?      @map("profile_icon_id")
  summonerLevel        Int?      @map("summoner_level")
  /// Current Solo/Flex entries from the last sync; `rank_snapshots` keeps the history for the LP graph.
  ranks                Json?
  topMasteries         Json?     @map("top_masteries")
  lastSyncedAt         DateTime? @map("last_synced_at") @db.Timestamptz(3)
  /// Start times of the oldest and newest match in an unbroken run of this player's match IDs from Riot.
  /// Other players' lookups store this player's matches outside the run; history pages stay inside it.
  matchHistoryFrom     DateTime? @map("match_history_from") @db.Timestamptz(3)
  matchHistoryTo       DateTime? @map("match_history_to") @db.Timestamptz(3)
  /// Riot has no matches older than `matchHistoryFrom`.
  matchHistoryComplete Boolean   @default(false) @map("match_history_complete")
  matchHistorySyncedAt DateTime? @map("match_history_synced_at") @db.Timestamptz(3)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  rankSnapshots RankSnapshot[]

  @@index([riotIdKey])
  @@map("riot_accounts")
}

model RankSnapshot {
  id           Int         @id @default(autoincrement())
  puuid        String      @db.VarChar(78)
  queue        RankedQueue
  tier         Tier
  division     Division
  leaguePoints Int         @map("league_points")
  wins         Int
  losses       Int
  takenAt      DateTime    @default(now()) @map("taken_at") @db.Timestamptz(3)

  account RiotAccount @relation(fields: [puuid], references: [puuid], onDelete: Cascade)

  @@index([puuid, queue, takenAt(sort: Desc)])
  @@map("rank_snapshots")
}

model Match {
  matchId     String   @id @map("match_id")
  platform    String
  queueId     Int      @map("queue_id")
  gameVersion String   @map("game_version")
  patch       String
  startedAt   DateTime @map("started_at") @db.Timestamptz(3)
  durationSec Int      @map("duration_sec")
  winnerTeam  Int?     @map("winner_team")
  remake      Boolean  @default(false)
  rawJson     Json     @map("raw_json")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  participants MatchParticipant[]
  timeline     MatchTimeline?

  @@map("matches")
}

/// No foreign key to riot_accounts: most participants are never looked up on the site.
/// queueId and startedAt are copied from matches so match history is served by one index.
model MatchParticipant {
  matchId           String   @map("match_id")
  participantId     Int      @map("participant_id")
  puuid             String   @db.VarChar(78)
  gameName          String?  @map("game_name")
  tagLine           String?  @map("tag_line")
  queueId           Int      @map("queue_id")
  startedAt         DateTime @map("started_at") @db.Timestamptz(3)
  teamId            Int      @map("team_id")
  /// Arena duo (1–8); null in team modes.
  subteamId         Int?     @map("subteam_id")
  /// Arena finish (1–8); null in team modes.
  placement         Int?
  championId        Int      @map("champion_id")
  champLevel        Int      @map("champ_level")
  role              String?
  kills             Int
  deaths            Int
  assists           Int
  damageToChampions Int      @map("damage_to_champions")
  goldEarned        Int      @map("gold_earned")
  cs                Int
  visionScore       Int      @map("vision_score")
  items             Int[]
  summonerSpells    Int[]    @map("summoner_spells")
  runes             Json
  win               Boolean

  match Match @relation(fields: [matchId], references: [matchId], onDelete: Cascade)

  @@id([matchId, participantId])
  @@index([puuid, startedAt(sort: Desc), matchId(sort: Desc)])
  @@index([puuid, queueId, startedAt(sort: Desc), matchId(sort: Desc)])
  @@map("match_participants")
}

model MatchTimeline {
  matchId   String   @id @map("match_id")
  frames    Json
  events    Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  match Match @relation(fields: [matchId], references: [matchId], onDelete: Cascade)

  @@map("match_timelines")
}

model StaticData {
  patch     String
  locale    String
  kind      StaticDataKind
  data      Json
  fetchedAt DateTime       @default(now()) @map("fetched_at") @db.Timestamptz(3)

  @@id([patch, locale, kind])
  @@map("static_data")
}
