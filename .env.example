NODE_ENV=development
# 0.0.0.0 inside containers
HOST=localhost
PORT=3000
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173
# defaults to true outside production
# SWAGGER_ENABLED=true

# Used by compose.yaml. Pick any local password and put the same one in DATABASE_URL.
# Redis is on 6380 to avoid clashing with a host Redis.
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql://lolinder:CHANGE_ME@localhost:5432/lolinder
REDIS_URL=redis://localhost:6380

# Worker only. Development keys expire every 24 hours: https://developer.riotgames.com
# RIOT_API_KEY=RGAPI-...

# Set behind a reverse proxy so throttling sees client IPs: proxy IPs/CIDRs, comma-separated
# TRUST_PROXY=10.0.0.0/8
